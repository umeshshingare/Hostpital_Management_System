# Copy to .env for local testing (NEVER commit .env)
# Replace values from Railway → MySQL → Variables

# Railway → Render mapping:
#   MYSQLHOST + MYSQLPORT + MYSQLDATABASE  →  DB_URL (JDBC)
#   MYSQLUSER                              →  DB_USERNAME
#   MYSQLPASSWORD                          →  DB_PASSWORD

DB_URL=jdbc:mysql://REPLACE_MYSQLHOST:REPLACE_MYSQLPORT/REPLACE_MYSQLDATABASE?useSSL=true&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_USERNAME=REPLACE_MYSQLUSER
DB_PASSWORD=REPLACE_MYSQLPASSWORD

SPRING_PROFILES_ACTIVE=prod
CORS_ALLOWED_ORIGIN_PATTERNS=https://*.vercel.app
CORS_ALLOWED_ORIGINS=https://your-app.vercel.app

# Vercel only (not used by backend):
# VITE_API_URL=https://your-service.onrender.com
